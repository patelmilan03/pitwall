# PitWall environment variables — copy to `.env` and fill in real values.
# `.env` is gitignored; NEVER commit real secrets. In CI these are GitHub Actions Secrets.

# --- Environment ---
# "dev" (default) writes under the dev/ S3 prefix; "prod" is CI-only. Never "prod" locally.
PITWALL_ENV=dev

# --- Object storage: S3-compatible endpoint (Backblaze B2) ---
# From the B2 bucket + application key you create in Phase 0. Bucket stays private.
S3_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=pitwall-data

# --- Warehouse: Supabase Postgres ---
# MUST be the Supavisor SESSION-POOLER string, not db.<ref>.supabase.co
# (the direct host is IPv6-only and fails from GitHub Actions/Streamlit — TRD §6.2).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Prefect (OPTIONAL) ---
# Leave blank for serverless ephemeral mode. Set both only to report to a free
# Prefect Cloud workspace (Stretch item).
# PREFECT_API_URL=
# PREFECT_API_KEY=
